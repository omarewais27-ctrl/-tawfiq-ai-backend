ternate;filter:saturate(1.08) drop-shadow(0 9px 8px rgba(0,0,0,.18))}@keyframes photoFocus{from{transform:scale(1)}to{transform:scale(1.035)}}@keyframes sandShift{from{filter:brightness(1)}to{filter:brightness(1.12)}}
/* candle wax */
.scene-candle{background:radial-gradient(ellipse at 50% 76%,rgba(255,112,38,calc((1 - var(--remain))*.18)),transparent 60%);border-radius:16px;width:115px!important;height:178px;left:calc(50% - 57px)!important;right:auto!important;top:8px}.scene-candle .candle-body,.scene-candle .candle-base,.scene-candle .candle-flame,.scene-candle .candle-glow{display:block}.candle-body{position:absolute;left:27px;bottom:18px;width:61px;height:calc(105px * var(--remain) + 13px);min-height:13px;background:linear-gradient(90deg,#c47c4d,#ffe0a1 28%,#f8c978 70%,#b86e40);border-radius:10px 10px 5px 5px;box-shadow:inset 4px 0 5px rgba(255,255,255,.35),inset -5px 0 6px rgba(111,53,22,.14);transition:height .5s}.candle-body:before{content:"";position:absolute;top:-4px;left:0;right:0;height:12px;background:linear-gradient(90deg,#f2bd6d,#fff0c3,#d9904c);border-radius:50%}.candle-wax{position:absolute;top:-2px;left:12px;width:12px;height:calc((1 - var(--remain))*23px + 4px);background:#ffe9b5;border-radius:0 0 7px 7px;opacity:.9}.candle-base{position:absolute;bottom:12px;left:16px;width:83px;height:10px;border-radius:50%;background:linear-gradient(#b98650,#805632)}.candle-flame{position:absolute;z-index:3;left:48px;top:10px;width:21px;height:34px;border-radius:55% 45% 55% 45%;background:radial-gradient(ellipse at 50% 70%,#fff8c5 0 20%,#ffcf52 43%,#ff8a29 68%,transparent 72%);filter:drop-shadow(0 0 8px rgba(255,158,43,.8));transform-origin:50% 90%;animation:flameFlicker .7s ease-in-out infinite alternate}.candle-glow{position:absolute;left:25px;top:-4px;width:68px;height:68px;background:radial-gradient(circle,rgba(255,179,68,.22),transparent 70%);animation:glowPulse 1.2s ease-in-out infinite alternate}@keyframes flameFlicker{to{transform:rotate(5deg) scale(.9,1.08)}}@keyframes glowPulse{to{opacity:.55;transform:scale(1.12)}}
/* coffee */
