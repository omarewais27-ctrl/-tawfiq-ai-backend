.study-hero{overflow:hidden}.study-head{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}.focus-badge{background:var(--card);border:1px solid var(--line);border-radius:99px;padding:7px 11px;color:var(--acc);font-size:11px;font-weight:800}.scene-picker{display:flex;gap:7px;overflow-x:auto;padding:8px 1px 4px;margin:10px 0;scrollbar-width:thin}.scene-choice{flex:0 0 auto;border:1px solid var(--line);border-radius:14px;background:var(--card);color:var(--ink);padding:7px 10px;font:inherit;font-size:11px;cursor:pointer}.scene-choice span{display:block;font-size:23px}.scene-choice.on{border-color:var(--acc);background:var(--soft);color:var(--acc);box-shadow:0 0 0 2px color-mix(in srgb,var(--acc) 12%,transparent)}
.study-stage{--remain:1;position:relative;height:215px;max-width:360px;margin:0 auto 2px;display:flex;align-items:center;justify-content:center;isolation:isolate}.scene-shadow{position:absolute;bottom:18px;width:145px;height:14px;background:rgba(0,0,0,.09);filter:blur(8px);border-radius:50%;z-index:-1}.study-stage>div:not(.scene-shadow){display:none}.study-stage[data-scene=hourglass] .scene-hourglass,.study-stage[data-scene=candle] .scene-candle,.study-stage[data-scene=coffee] .scene-coffee,.study-stage[data-scene=plant] .scene-plant,.study-stage[data-scene=aquarium] .scene-aquarium{display:block;position:absolute;inset:0}
