<style>
:root{--h:168;--bg:#f4f1e8;--card:#fffdf8;--ink:#23342f;--mut:#6f7f78;--line:#e4dfd0;--acc:hsl(var(--h) 38% 36%);--soft:hsl(var(--h) 30% 92%);--gold:#b8923f;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
