.study-trend-graph{display:block;width:100%;max-width:220px;height:92px;margin:12px auto 0;overflow:visible}.study-trend-graph .axis{stroke:var(--mut);stroke-width:1.5;opacity:.65}.study-trend-graph .graph-label{font:8px Cairo,sans-serif;fill:var(--mut)}.study-numeric-summary{margin-top:12px}.study-numeric-summary b{font-size:14px!important;color:#ff4655!important}.study-numeric-summary>div,.study-trend-main,.study-trend-arrow{color:#ff4655}.study-trend.up .study-trend-arrow{color:#ff4655;background:rgba(255,70,85,.1);border-color:rgba(255,70,85,.3)}.study-trend.down .study-trend-arrow{color:#ff4655;background:rgba(255,70,85,.1);border-color:rgba(255,70,85,.3)}.study-trend-graph .trend-line,.study-trend-graph .trend-tip{stroke:#ff4655;fill:#ff4655}.study-trend.up .trend-line,.study-trend.up .trend-tip,.study-trend.down .trend-line,.study-trend.down .trend-tip{stroke:#ff4655;fill:#ff4655}.study-week-legend{color:#ff737e}.bars div{position:relative}.bars div em{font-style:normal;font-size:9px;line-height:1.5;color:var(--ink)}.study-trend-graph .trend-line{fill:none;stroke:var(--acc);stroke-width:3.5;stroke-linecap:round;stroke-linejoin:round;filter:drop-shadow(0 2px 2px rgba(0,0,0,.12))}.study-trend-graph .trend-tip{fill:var(--acc)}.study-trend.up .trend-line,.study-trend.up .trend-tip{stroke:#16a34a;fill:#16a34a}.study-trend.down .trend-line,.study-trend.down .trend-tip{stroke:#dc2626;fill:#dc2626}.study-week-legend{display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap;margin-top:8px;font-size:11px;color:var(--mut)}
