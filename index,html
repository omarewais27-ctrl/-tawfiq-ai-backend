<!DOCTYPE html><html lang="ar" dir="rtl" data-mode="bac"><head><meta charset="utf-8">
<script>
/* ===== توفيق: عزل بيانات كل حساب (لازم يشتغل قبل كود التطبيق) ===== */
(function(){
 try{
  var LS=window.localStorage,SS=window.sessionStorage,SP=Storage.prototype;
  var rawGet=SP.getItem,rawSet=SP.setItem,rawDel=SP.removeItem,rawKey=SP.key;
  var users=[];try{users=JSON.parse(rawGet.call(LS,'tw_auth:users')||'[]')}catch(e){}
  var sid=null;try{sid=rawGet.call(LS,'tw_auth:session')||rawGet.call(SS,'tw_auth:session')}catch(e){}
  var user=null;for(var i=0;i<users.length;i++){if(users[i].id===sid)user=users[i]}
  var pre=user?('tw_u_'+user.id+'::'):'tw_locked::';
  if(!user){for(var j=LS.length-1;j>=0;j--){var kk=rawKey.call(LS,j);if(kk&&kk.indexOf('tw_locked::')===0)rawDel.call(LS,kk)}}
  SP.getItem=function(k){return this===LS?rawGet.call(this,pre+k):rawGet.call(this,k)};
  SP.setItem=function(k,v){return this===LS?rawSet.call(this,pre+k,v):rawSet.call(this,k,v)};
  SP.removeItem=function(k){return this===LS?rawDel.call(this,pre+k):rawDel.call(this,k)};
  window.TW={user:user,pre:pre,db:user?(user.legacy?'tawfiq_media':'tawfiq_media_'+user.id):'tawfiq_locked',
   raw:{get:function(k){return rawGet.call(LS,k)},set:function(k,v){rawSet.call(LS,k,v)},del:function(k){rawDel.call(LS,k)},key:function(i){return rawKey.call(LS,i)},len:function(){return LS.length}}};
  if(!user)document.documentElement.className+=' tw-locked';
 }catch(e){window.TW={noauth:true,db:'tawfiq_media',user:{id:'guest',name:'ضيف'}}}
})();
</script>
