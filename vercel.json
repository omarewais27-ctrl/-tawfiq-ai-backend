{
  "version": 2,
  "builds": [
    { "src": "chat.js", "use": "@vercel/node" },
    { "src": "tutor.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api/chat", "dest": "/chat.js" },
    { "src": "/api/tutor", "dest": "/tutor.js" },
    { "src": "/", "dest": "/index.html" }
  ]
}
